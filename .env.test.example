# Dedicated integration-test database.
# Never point this to development or production data: integration tests truncate
# every public table except _prisma_migrations.
DATABASE_URL_TEST="postgresql://admin:secret_test@localhost:55436/whatsapp_hub_test?schema=public"

NODE_ENV=test
ENABLE_JOBS=false
USE_REDIS=false
SERVE_FRONTEND=false
ENABLE_SWAGGER=false
ENABLE_LEGACY_OPERATIONS=true

JWT_SECRET=test-jwt-secret-change-me
ENCRYPTION_KEY=12345678901234567890123456789012
FILE_URL_SECRET=test-file-url-secret
FRONTEND_URL=http://localhost:5180
CORS_ORIGINS=http://localhost:5180

# Optional local test DB bootstrap:
# docker run --name whatspoint-postgres-test -e POSTGRES_USER=admin -e POSTGRES_PASSWORD=secret_test -e POSTGRES_DB=whatsapp_hub_test -p 55436:5432 -d postgres:15-alpine
# DATABASE_URL="$DATABASE_URL_TEST" npx prisma migrate deploy
# npm run test:integration
