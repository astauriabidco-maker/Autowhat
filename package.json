    "verify:full": "npm run verify && npm run test:integration && npm run test:e2e",
    "env:check": "ts-node scripts/checkProductionEnv.ts",
    "env:check:runtime": "node scripts/checkProductionEnv.js",
    "env:check:strict": "node scripts/checkProductionEnv.js --strict-warnings",
    "prod:readiness": "npm run env:check:strict",
    "migrate:whatsapp-tokens": "ts-node scripts/migrateWhatsappTokensToGcm.ts",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
