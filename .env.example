# --- REQUIRED ---
ENCRYPTION_KEY=your-32-character-secret-key-!!
POSTGRES_PORT=55435
DATABASE_URL="postgresql://admin:secret_dev@localhost:55435/whatsapp_hub?schema=public"
JWT_SECRET=your-secure-jwt-secret
FILE_URL_SECRET=your-separate-file-url-signing-secret

# --- CONFIGURATION ---
PORT=3005
FRONTEND_URL=http://localhost:5180
BACKEND_URL=http://localhost:3005
BASE_URL=http://localhost:3005
APP_URL=http://localhost:5180
VITE_API_BASE_URL=
# Frontend public bot number for the landing "Demo WhatsApp" CTA.
# Digits only or international format; example: 33612345678.
VITE_BOT_PHONE_NUMBER=
CORS_ORIGINS=http://localhost:5180
NODE_ENV=development
SERVE_FRONTEND=false
ENABLE_SWAGGER=false
AUTH_COOKIE_SAME_SITE=lax
# Set to true for truly cross-site frontend/backend deployments, e.g. Vercel + Render.
# This forces SameSite=None and Secure cookies.
AUTH_COOKIE_CROSS_SITE=false
AUTH_COOKIE_SECURE=false
USE_REDIS=false
REDIS_URL=redis://localhost:6379
QUEUE_RATE_LIMIT=60

# --- FIRST SUPERADMIN SEED (Optional, production startup only) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-long-random-password
SUPER_ADMIN_NAME=Super Admin

# --- STRIPE (Optional) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# --- WHATSAPP / META (Optional) ---
WHATSAPP_TOKEN=...
WHATSAPP_API_TOKEN=...
WHATSAPP_PHONE_ID=...
WHATSAPP_PHONE_NUMBER_ID=...
WEBHOOK_VERIFY_TOKEN=...
WHATSAPP_VERIFY_TOKEN=...

# --- EMAIL / AI / SMS (Optional) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
SENDGRID_API_KEY=...
OPENAI_API_KEY=...
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
