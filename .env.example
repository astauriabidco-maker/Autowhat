# --- REQUIRED ---
# Production refuses placeholder/test values. Generate independent secrets:
#   openssl rand -base64 48
# ENCRYPTION_KEY is special: it must be exactly 32 characters.
ENCRYPTION_KEY=your-32-character-secret-key-!!
POSTGRES_PORT=55435
DATABASE_URL="postgresql://admin:secret_dev@localhost:55435/whatsapp_hub?schema=public"
JWT_SECRET=your-secure-jwt-secret
FILE_URL_SECRET=your-separate-file-url-signing-secret
LOG_HASH_SECRET=your-separate-log-hashing-secret

# --- CONFIGURATION ---
PORT=3005
FRONTEND_URL=http://localhost:5180
BACKEND_URL=http://localhost:3005
BASE_URL=http://localhost:3005
APP_URL=http://localhost:5180
VITE_API_BASE_URL=
# Frontend public bot number for the landing "Demo WhatsApp" CTA.
# Digits only or international format; example: 33612345678.
VITE_BOT_PHONE_NUMBER=
CORS_ORIGINS=http://localhost:5180
NODE_ENV=development
SERVE_FRONTEND=false
ENABLE_SWAGGER=false
DEMO_MODE=true
AUTH_COOKIE_SAME_SITE=lax
# Set to true for truly cross-site frontend/backend deployments, e.g. Vercel + Render.
# This forces SameSite=None and Secure cookies.
AUTH_COOKIE_CROSS_SITE=false
AUTH_COOKIE_SECURE=false
USE_REDIS=false
REDIS_URL=redis://localhost:6379
QUEUE_RATE_LIMIT=60
# Uses Redis for express-rate-limit when USE_REDIS=true.
# Set RATE_LIMIT_STORE=memory to force local in-memory counters.
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_PREFIX=whatspoint:rate-limit
RATE_LIMIT_REDIS_PASS_ON_ERROR=false
WHATSAPP_POOL_ALERT_EMAILS=
WHATSAPP_POOL_HEALTH_CRON="*/30 * * * *"
WHATSAPP_POOL_ALERT_TTL_SECONDS=21600
ONBOARDING_ACCESS_RATE_LIMIT_WINDOW_MS=900000
ONBOARDING_ACCESS_RATE_LIMIT_MAX=20
ONBOARDING_ALLOWED_COUNTRIES=FR,BE,CH,LU,CA,CM,SN,CI
ONBOARDING_BLOCKED_COUNTRIES=
ONBOARDING_BLOCKED_PHONE_PREFIXES=
ONBOARDING_PHONE_COOLDOWN_HOURS=24
ONBOARDING_PHONE_DAILY_LIMIT=3
ONBOARDING_IP_HOURLY_LIMIT=5
ONBOARDING_DAILY_GLOBAL_LIMIT=200
ONBOARDING_DAILY_COUNTRY_LIMIT=50
ONBOARDING_DAILY_COUNTRY_LIMITS={}
ONBOARDING_TURNSTILE_ENABLED=false
ONBOARDING_TURNSTILE_IP_THRESHOLD=3

# --- FIRST SUPERADMIN SEED (Optional, production startup only) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-long-random-password
SUPER_ADMIN_NAME=Super Admin

# --- STRIPE (Optional) ---
# If STRIPE_SECRET_KEY is set in production, STRIPE_WEBHOOK_SECRET and price IDs are required too.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# --- WHATSAPP / META (Optional) ---
# Production requires a Meta app secret for x-hub-signature-256 validation.
WHATSAPP_TOKEN=...
WHATSAPP_API_TOKEN=...
WHATSAPP_PHONE_ID=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_APP_SECRET=...
WEBHOOK_VERIFY_TOKEN=...
WHATSAPP_VERIFY_TOKEN=...
# Optional: approved Meta template used to invite employees proactively.
WHATSAPP_EMPLOYEE_INVITE_TEMPLATE=whatspoint_employee_access_fr
WHATSAPP_EMPLOYEE_INVITE_TEMPLATE_LANG=fr
# Optional: approved Meta template used for manager login OTP outside the 24h window.
WHATSAPP_LOGIN_OTP_TEMPLATE=whatspoint_login_otp_fr
WHATSAPP_LOGIN_OTP_TEMPLATE_LANG=fr
# Optional: approved Meta template used for the public "request access" flow.
WHATSAPP_ONBOARDING_ACCESS_TEMPLATE=whatspoint_request_access_fr
WHATSAPP_ONBOARDING_ACCESS_TEMPLATE_LANG=fr

# --- EMAIL / AI / SMS (Optional) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
SENDGRID_API_KEY=...
OPENAI_API_KEY=...
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...

# --- FEATURE FLAGS / MOCK GUARDS ---
# Development defaults keep the local demo experience working.
# In production, keep DEMO_MODE=false and explicitly enable only real integrations.
ENABLE_AI_AGENTS=true
ENABLE_KPAIE=false
ENABLE_DYNAMIC_NUMBER_PROVISIONING=false
ENABLE_META_EMBEDDED_SIGNUP=false
# Retired CRM/FSM surface: customers, interventions, dispatch, quotes, parts,
# intervention reports, recurring interventions and customer WhatsApp requests.
# Defaults to true outside production for local inspection; keep false in production.
ENABLE_LEGACY_OPERATIONS=false
