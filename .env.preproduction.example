# Coolify preproduction template for testbed.whatspoint.com.
# Copy values into Coolify Environment Variables. Do not commit real secrets.
# Validate with: npm run env:check

NODE_ENV=production
APP_ENV=preproduction
DEMO_MODE=false
SERVE_FRONTEND=true
ENABLE_SWAGGER=false

# Public preproduction domains
FRONTEND_URL=https://testbed.whatspoint.com
BACKEND_URL=https://api.testbed.whatspoint.com
BASE_URL=https://api.testbed.whatspoint.com
APP_URL=https://testbed.whatspoint.com
CORS_ORIGINS=https://testbed.whatspoint.com

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Secrets
# Generate independent values. ENCRYPTION_KEY must be exactly 32 characters.
ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_CHARACTERS
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
FILE_URL_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
LOG_HASH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET

# Cookies
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_CROSS_SITE=false
AUTH_COOKIE_SAME_SITE=lax

# Jobs and queues
ENABLE_JOBS=true
USE_REDIS=true
REDIS_URL=redis://USER:PASSWORD@HOST:6379
QUEUE_RATE_LIMIT=60
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_PREFIX=whatspoint:preprod:rate-limit
RATE_LIMIT_REDIS_PASS_ON_ERROR=false

# WhatsApp pool and onboarding guardrails
WHATSAPP_POOL_ALERT_EMAILS=ops@example.com
WHATSAPP_POOL_HEALTH_CRON="*/30 * * * *"
WHATSAPP_POOL_ALERT_TTL_SECONDS=21600
ONBOARDING_ACCESS_RATE_LIMIT_WINDOW_MS=900000
ONBOARDING_ACCESS_RATE_LIMIT_MAX=20
ONBOARDING_ALLOWED_COUNTRIES=FR,BE,CH,LU,CA,CM,SN,CI
ONBOARDING_BLOCKED_COUNTRIES=
ONBOARDING_BLOCKED_PHONE_PREFIXES=
ONBOARDING_PHONE_COOLDOWN_HOURS=24
ONBOARDING_PHONE_DAILY_LIMIT=3
ONBOARDING_IP_HOURLY_LIMIT=5
ONBOARDING_DAILY_GLOBAL_LIMIT=200
ONBOARDING_DAILY_COUNTRY_LIMIT=50
ONBOARDING_DAILY_COUNTRY_LIMITS={}
ONBOARDING_TURNSTILE_ENABLED=false
ONBOARDING_TURNSTILE_IP_THRESHOLD=3

# WhatsApp / Meta
WHATSAPP_TOKEN=REPLACE_WITH_META_ACCESS_TOKEN
WHATSAPP_API_TOKEN=REPLACE_WITH_META_ACCESS_TOKEN
WHATSAPP_PHONE_ID=REPLACE_WITH_META_PHONE_ID
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_META_PHONE_NUMBER_ID
WHATSAPP_APP_SECRET=REPLACE_WITH_META_APP_SECRET
WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_LONG_RANDOM_VERIFY_TOKEN
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_LONG_RANDOM_VERIFY_TOKEN
WHATSAPP_EMPLOYEE_INVITE_TEMPLATE=whatspoint_employee_access_fr
WHATSAPP_EMPLOYEE_INVITE_TEMPLATE_LANG=fr
WHATSAPP_LOGIN_OTP_TEMPLATE=whatspoint_login_otp_fr
WHATSAPP_LOGIN_OTP_TEMPLATE_LANG=fr
WHATSAPP_ONBOARDING_ACCESS_TEMPLATE=whatspoint_request_access_fr
WHATSAPP_ONBOARDING_ACCESS_TEMPLATE_LANG=fr

# Stripe, required only if billing is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Optional integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Product boundary and mock guards
ENABLE_AI_AGENTS=true
ENABLE_KPAIE=false
ENABLE_DYNAMIC_NUMBER_PROVISIONING=false
ENABLE_META_EMBEDDED_SIGNUP=false
ENABLE_LEGACY_OPERATIONS=false
